# Scripts that run inside Linux containers must keep LF endings regardless
# of the checkout platform's git autocrlf setting — a CRLF shebang line
# breaks the interpreter lookup (e.g. "bash\r: No such file or directory").
*.sh text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf

# The embedded attack catalog is integrity-checked by SHA-256 at startup;
# line-ending conversion on checkout would change its bytes and (correctly)
# fail that check. Keep it byte-identical on every platform.
services/api/internal/adapters/atomic/catalog.json -text
